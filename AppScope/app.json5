{
  "app": {
    // 占位包名：正式应用必须改成自己的包名，且与 AGC 创建应用时填写的包名完全一致。
    // 包名一旦在 AGC 创建就不可修改，改包名等于新建一个应用。
    "bundleName": "com.example.template",
    "vendor": "example",
    // versionCode 每次提交必须递增；versionName 面向用户。
    "versionCode": 1000000,
    "versionName": "1.0.0",
    "icon": "$media:app_icon",
    "label": "$string:app_name"
  }
}
